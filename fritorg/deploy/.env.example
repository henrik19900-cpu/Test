# Copy to .env and fill in. Never commit the real .env.

# Your domain (DNS A/AAAA record must point to this server)
DOMAIN=fritorg.no
FRITORG_BASE_URL=https://fritorg.no
FRITORG_SITE_NAME=Fritorg

# Who runs the site (shown in the terms) and how to reach you
FRITORG_OPERATOR=Fritorg AS (org.nr. 000 000 000)
FRITORG_CONTACT_EMAIL=post@fritorg.no

# Keys identity hashes and signed links. Generate once and keep it safe:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FRITORG_SECRET_KEY=

# --- Verifying people (pick one) ------------------------------------------------------------
#
# A) Default: Norwegian mobile number confirmed by SMS code. Needs no special agreement,
#    only an account with an SMS provider. Each number can verify one account.
FRITORG_VERIFICATION=sms
# "twilio" or "http" (any provider with a simple HTTP API). "console" only shows codes on
# screen and is refused on an https site unless FRITORG_ALLOW_CONSOLE_SMS=1 (demo sites).
FRITORG_SMS_PROVIDER=twilio
FRITORG_TWILIO_ACCOUNT_SID=
FRITORG_TWILIO_AUTH_TOKEN=
# A sender ID ("Fritorg", max 11 characters; check that your account may use it for Norway) or a number you own
FRITORG_TWILIO_FROM=Fritorg
# For FRITORG_SMS_PROVIDER=http: a URL template with {to} (+4791234567), {to_digits}
# (4791234567), {to_local} (91234567) and {message}; values are URL-encoded. With
# FRITORG_SMS_METHOD=POST the query string is sent as a form body instead. Example:
#   FRITORG_SMS_URL=https://sms.example.no/send?key=SECRET&from=Fritorg&to={to_digits}&text={message}
FRITORG_SMS_URL=
FRITORG_SMS_METHOD=GET
# Cost caps: codes per day for the whole site, and per IP address per hour
FRITORG_SMS_DAILY_LIMIT=2000
FRITORG_SMS_PER_IP_PER_HOUR=10
#
# B) Optional: BankID through an OpenID Connect broker (BankID, Signicat, Idura/Criipto, ...).
#    Needs an agreement with the broker. Replaces passwords and SMS: accounts are created and
#    logged into with BankID. Register https://<your domain>/bankid/callback with the provider.
FRITORG_BANKID=off
FRITORG_BANKID_ISSUER=
FRITORG_BANKID_CLIENT_ID=
FRITORG_BANKID_CLIENT_SECRET=
# Provider specific, e.g. urn:grn:authn:no:bankid for Idura/Criipto
FRITORG_BANKID_ACR_VALUES=
FRITORG_BANKID_SCOPE=openid profile
# Claim with a stable person identifier (default "sub"); only a keyed hash is stored
FRITORG_BANKID_ID_CLAIM=sub

# --- Outgoing e-mail for verification links and notifications --------------------------------
FRITORG_SMTP_HOST=
FRITORG_SMTP_PORT=587
FRITORG_SMTP_SECURITY=starttls
FRITORG_SMTP_USERNAME=
FRITORG_SMTP_PASSWORD=
FRITORG_SMTP_FROM=Fritorg <post@fritorg.no>

# --- Job ads from Nav (arbeidsplassen.no) --------------------------------------------------------
# Nav's open job feed may be republished (https://arbeidsplassen.nav.no/vilkar-api). Ads are kept in
# sync and removed as soon as they end. The first import of all current ads takes a few hours.
FRITORG_NAV_IMPORT=1
# Production token: e-mail nav.team.arbeidsplassen@nav.no that you accept the terms, with company name,
# contact person, e-mail and phone. Without it the public test token is used, which Nav rotates.
FRITORG_NAV_TOKEN=

# --- More open data (no agreement needed) ------------------------------------------------------
# Venues and facilities Stavanger kommune rents out (NLOD), refreshed daily
FRITORG_STAVANGER_IMPORT=1
# Swedish job ads in Norway or asking for Norwegian (Platsbanken, CC0), refreshed every three hours
FRITORG_JOBTECH_IMPORT=1

# Optional: demo listings on first start (do not use on the real site)
FRITORG_SEED_DEMO=0
