# Copy to .env and fill in. Never commit the real .env.

# Your domain (DNS A/AAAA record must point to this server)
DOMAIN=fritorg.no
FRITORG_BASE_URL=https://fritorg.no
FRITORG_SITE_NAME=Fritorg

# Who runs the site (shown in the terms) and how to reach you
FRITORG_OPERATOR=Fritorg AS (org.nr. 000 000 000)
FRITORG_CONTACT_EMAIL=post@fritorg.no

# Keys identity hashes and signed links. Generate once and keep it safe:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FRITORG_SECRET_KEY=

# BankID through an OpenID Connect provider (BankID, Signicat, Idura/Criipto, ...).
# Register the redirect URI https://<your domain>/bankid/callback with the provider.
FRITORG_BANKID=oidc
FRITORG_BANKID_ISSUER=
FRITORG_BANKID_CLIENT_ID=
FRITORG_BANKID_CLIENT_SECRET=
# Provider specific, e.g. urn:grn:authn:no:bankid for Idura/Criipto
FRITORG_BANKID_ACR_VALUES=
FRITORG_BANKID_SCOPE=openid profile
# Claim with a stable person identifier (default "sub"); only a keyed hash is stored
FRITORG_BANKID_ID_CLAIM=sub

# Outgoing e-mail for verification and notifications
FRITORG_SMTP_HOST=
FRITORG_SMTP_PORT=587
FRITORG_SMTP_SECURITY=starttls
FRITORG_SMTP_USERNAME=
FRITORG_SMTP_PASSWORD=
FRITORG_SMTP_FROM=Fritorg <post@fritorg.no>

# Optional: demo listings on first start (do not use on the real site)
FRITORG_SEED_DEMO=0
