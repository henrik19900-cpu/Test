# Caddy gets and renews HTTPS certificates automatically for $DOMAIN.
#
# Visitors' addresses: Caddy sets X-Forwarded-For itself and ignores what visitors send. Behind a CDN or
# another proxy, every visitor would get that proxy's address and share its rate limits; then add the
# proxy's address ranges both here (`trusted_proxies static ...` under `servers` in the global options)
# and to FORWARDED_ALLOW_IPS in .env.
{$DOMAIN} {
	encode zstd gzip

	# Photos are served straight from the data volume, so the app only builds pages. Their names are
	# random and never reused, so browsers and CDNs may keep them forever.
	handle_path /uploads/* {
		root * /srv/uploads
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server {
			hide .*
		}
	}

	handle {
		reverse_proxy app:8000
	}

	log {
		output stdout
		format console
	}
}

# Send www to the main domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
