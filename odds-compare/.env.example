# Copy to .env and fill in. .env is never committed.
# Free key (1,000 requests a month, no card): https://oddslink.app
ODDSLINK_API_KEY=
# Free key (500 credits a month, no card): https://the-odds-api.com
THE_ODDS_API_KEY=
# Only when reference.source is odds_api_io (paid)
ODDS_API_IO_KEY=
# Optional: a Postgres database (e.g. Neon's free plan) that keeps a copy of the bet log
DATABASE_URL=
